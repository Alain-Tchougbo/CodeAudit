{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "report-export.v2.schema.json",
  "title": "CodeAudit report export v2 with recorded Git source",
  "type": "object",
  "properties": {
    "schemaVersion": { "const": 2 },
    "project": { "$ref": "report-export.v1.schema.json#/properties/project" },
    "analysis": { "$ref": "report-export.v1.schema.json#/properties/analysis" },
    "report": { "$ref": "report-export.v1.schema.json#/properties/report" },
    "source": {
      "type": "object",
      "properties": {
        "schemaVersion": { "const": 1 },
        "provider": { "const": "GITHUB" },
        "repository": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,38}/[A-Za-z0-9_.-]{1,100}$" },
        "archiveRepository": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,38}/[A-Za-z0-9_.-]{1,100}$" },
        "requestedRef": { "type": "string", "minLength": 1, "maxLength": 200 },
        "commitSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "pullRequest": { "anyOf": [{ "type": "null" }, { "type": "integer", "minimum": 1 }] }
      },
      "required": ["schemaVersion", "provider", "repository", "archiveRepository", "requestedRef", "commitSha", "pullRequest"],
      "additionalProperties": false
    }
  },
  "required": ["schemaVersion", "project", "analysis", "report", "source"],
  "additionalProperties": false
}
