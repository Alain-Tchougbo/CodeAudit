{
  "name": "@codeaudit/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --watch --require ts-node/register src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "lint": "eslint src test \"*.cjs\" --max-warnings 0",
    "test:integration": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.integration.config.cjs --runInBand"
  },
  "dependencies": {
    "@codeaudit/analysis-jobs": "workspace:*",
    "@codeaudit/contracts": "workspace:*",
    "@codeaudit/database": "workspace:*",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "nodemailer": "10.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@codeaudit/config": "workspace:*",
    "@nestjs/testing": "^11.1.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.0.0",
    "@types/supertest": "^6.0.0",
    "jest": "^30.0.0",
    "supertest": "^7.1.0",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2"
  }
}
