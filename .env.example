# Valeurs de developpement local uniquement.
POSTGRES_USER=codeaudit
POSTGRES_PASSWORD=codeaudit
POSTGRES_DB=codeaudit
POSTGRES_PORT=5432
DATABASE_URL=postgresql://codeaudit:codeaudit@127.0.0.1:5432/codeaudit?schema=public
# Origine du navigateur ; changer avec WEB_PORT. HTTPS obligatoire avec NODE_ENV=production.
AUTH_APP_ORIGIN=http://127.0.0.1:5173
# Initialiser une cle serveur avec pnpm auth:init-key, sans afficher sa valeur.
# Conserver/sauvegarder cette cle hors de Git ; ne pas la remplacer sans migration des secrets.
# SECURITY_ENCRYPTION_KEY=
# OAuth facultatif : creer deux applications serveur avec ces callbacks exacts :
# http://127.0.0.1:5173/api/auth/oauth/GITHUB/callback
# http://127.0.0.1:5173/api/auth/oauth/GITLAB/callback
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITLAB_CLIENT_ID=
# GITLAB_CLIENT_SECRET=
# Boite de developpement locale, demarrer avec pnpm mail:up.
SMTP_HOST=127.0.0.1
SMTP_PORT=1026
MAIL_FROM=CodeAudit <no-reply@codeaudit.local>
# Production : configurer votre fournisseur SMTP et ses secrets hors de Git.
# SMTP_SECURE=true
# SMTP_USER=
# SMTP_PASSWORD=
# Option du terminal pour API et worker : CODEAUDIT_STORAGE_ROOT (defaut .tmp/imports).
